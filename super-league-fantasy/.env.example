# Copy to .env.local for local dev (optional — defaults to localhost:3000 if unset).
# In Vercel: Project Settings -> Environment Variables -> add VITE_API_BASE
# pointing at your deployed Render backend, e.g.:
#   VITE_API_BASE=https://super-league-backend.onrender.com
# No trailing slash, no /api suffix (the app appends /api itself).
VITE_API_BASE=http://localhost:3000
