# ==============================================================
# SUPER LEAGUE FANTASY - Environment Configuration
# ==============================================================
# COPY this file to .env and fill in your real values
# DO NOT commit your real .env file to Git!

# --- PostgreSQL Database ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/fantasy_db"

# --- JWT Authentication ---
# Must be a long, random, unguessable string (never a real word/phrase).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the value in this example file — auth.js refuses to boot if it detects this exact placeholder.
JWT_SECRET="REPLACE_ME_WITH_A_GENERATED_RANDOM_SECRET"

# --- Refresh Token (httpOnly cookie) ---
# A SEPARATE random secret from JWT_SECRET (generate the same way) — keeping
# access-token and refresh-token signing keys independent means a leak of one
# doesn't automatically forge the other.
JWT_REFRESH_SECRET="REPLACE_ME_WITH_A_DIFFERENT_GENERATED_RANDOM_SECRET"

# --- CORS ---
# Origin(s) allowed to call this API. Comma-separated for multiple origins.
# Must NOT be "*" in production once cookies/credentials are involved.
FRONTEND_ORIGIN="http://localhost:5173"

# --- Redis Cache & Leaderboard ---
REDIS_URL="redis://localhost:6379"

# --- Server ---
PORT=3000

# --- Sportmonks API (Player Profile Enrichment) ---
# Get one at: https://www.sportmonks.com/
SPORTMONKS_API_TOKEN="NTqtM3CoEd8Pwl2ZazndjImlO0vsvRPO9MvQWq8kfGOxPW18qHWtjEmvk4i8"

# Can override the include chain to optimize the payload if desired
SPORTMONKS_PLAYER_INCLUDE="trophies.league;trophies.season;trophies.trophy;trophies.team;teams.team;statistics.details.type;statistics.team;statistics.season.league;latest.fixture.participants;latest.fixture.league;latest.fixture.scores;latest.details.type;nationality;detailedPosition;metadata.type"

# --- Seed Players from Sportmonks ---
SPORTMONKS_SEED_PER_PAGE=100
SPORTMONKS_SEED_MAX_PAGES=120
SPORTMONKS_SEED_TARGET=2500
# Example Top 5 league IDs (adjust based on your account/dataset)
SPORTMONKS_TOP5_LEAGUE_IDS="8,564,301,82,384"

# --- Seed Players from football-data.org (Top 5 European leagues) ---
# Register for free at: https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=""

# --- Seed Players from API-Football free tier (Top 5 leagues, recommended) ---
# Register for free at: https://dashboard.api-football.com/register
API_FOOTBALL_KEY=""

# --- Social Login: "Continue with Google/Facebook/X" (routes/oauth.js) ---
# Leave a provider's ID/secret blank to disable it — GET /api/auth/<provider>
# responds 503 "not configured" instead of crashing, everything else still
# works. Each provider needs its callback URL registered EXACTLY as:
#   <your backend origin>/api/auth/google/callback
#   <your backend origin>/api/auth/facebook/callback
#   <your backend origin>/api/auth/twitter/callback
# (http://localhost:3000/... for local dev)

# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web application)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook for Developers -> your app -> Settings > Basic (App ID / App Secret)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# X (Twitter) Developer Portal -> your app -> Keys and tokens -> OAuth 2.0 Client ID and Client Secret
# Requires "Sign in with X" enabled under User authentication settings.
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# Override if the backend is reachable from the internet under a different
# origin than what req.protocol/req.get('host') would report (e.g. behind a
# reverse proxy). Leave unset for local dev — it's derived automatically.
# OAUTH_CALLBACK_BASE_URL="https://api.yourdomain.com"
